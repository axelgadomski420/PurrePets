{
  "name": "purrepets-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted backend of PURRE PETS (Express + PostgreSQL + Prisma + Socket.IO)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
