# PURRE PETS — backend: zmienne środowiskowe.
# Skopiuj do backend/.env i ustaw wartości. NIGDY nie commituj backend/.env.
# Sekrety z dawnego .env / ecosystem.config.cjs wyciekły do publicznego repo — MUSZĄ zostać zrotowane
# (instrukcja: docs/NODE-MIGRATION.md, sekcja "Rotacja sekretów").

# --- Baza danych (PostgreSQL) ---
DATABASE_URL="postgresql://UZYTKOWNIK:HASLO@127.0.0.1:5432/purrepets?schema=public"

# --- Bezpieczeństwo ---
# Wygeneruj nowy sekret: openssl rand -hex 48
JWT_SECRET="ZMIEN_MNIE_NA_DLOUGI_LOSOWY_SEKRET"
JWT_EXPIRES_IN="7d"

# --- Serwer ---
PORT=4000
HOST=127.0.0.1
NODE_ENV=production
FRONTEND_PORT=3000

# --- Publiczne URL-e / CORS ---
PUBLIC_BASE_URL="https://purrepets.pl"
CORS_ORIGINS="https://purrepets.pl,https://www.purrepets.pl"

# --- Uploady ---
UPLOAD_DIR="/var/www/purrepets/uploads"
MAX_UPLOAD_BYTES=104857600

# --- SMTP (kody OTP przy rejestracji) — opcjonalne ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PURRE PETS <no-reply@purrepets.pl>"

# --- Stripe (pakiety PURRE Coins). Puste = sklep pokazuje pakiety, ale nie otwiera płatności. ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- AI (Ollama na tym samym VM) — model faktycznie dostępny na serwerze ---
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"

# --- Admini (emaile rozdzielone przecinkiem) ---
ADMIN_EMAILS="admin@example.com"
