# PURRE PETS — wzorzec zmiennych środowiskowych (BEZ sekretów).
# Frontend (Vite): zmienne VITE_* muszą być ustawione w czasie buildu.
# Backend: skopiuj backend/.env.example do backend/.env — tam żyją wszystkie sekrety.

# --- Frontend ---
# Pusty = ta sama domena (produkcja za Nginx). W dev: http://127.0.0.1:4000
VITE_API_URL=""
# Publiczny klucz witryny Google AdSense (tylko AdSense — brak innych sieci reklamowych)
VITE_ADSENSE_CLIENT=""

# --- Backend (szczegóły w backend/.env.example) ---
# DATABASE_URL, JWT_SECRET, SMTP_*, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# OLLAMA_URL, OLLAMA_MODEL, UPLOAD_DIR, CORS_ORIGINS, ADMIN_EMAILS
